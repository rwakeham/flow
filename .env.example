# ./setup.sh writes .env for you. To write it by hand instead, copy this file to
# .env, fill in the values, then run ./deploy.sh.

# The three values below are blank on purpose: deploy.sh refuses to run until
# they are filled in, and refuses the old example values. FLOW_PASSWORD is for
# the first start: Flow then keeps the password itself (as a hash in its
# database; Sign out ▾ → Change password in the app) and this line can go.
# While it stays here it is copied in at every start, which is also how a
# forgotten password is reset.
#
# Put a value with spaces, $, # or quotes in double quotes, with \ " and $
# escaped by a backslash: FLOW_PASSWORD="pa\$word #1". Unquoted, Docker Compose
# reads $name as a variable and " #" as the start of a comment. Keep the file
# private: chmod 600 .env (setup.sh does this for you).

# PostgreSQL password (used internally between containers)
# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=

# Password to log in to the dashboard (first start; see above)
FLOW_PASSWORD=

# Random secret key for signing session cookies, at least 32 characters.
# Generate with: openssl rand -hex 32
SECRET_KEY=

# Host port to expose the app on (change if 8000 is already in use)
APP_PORT=8000

# Mark the session cookie Secure; enable when serving over HTTPS behind a
# reverse proxy. Optional, defaults to false.
#COOKIE_SECURE=false

# Reverse proxies whose X-Forwarded-For header is believed, comma-separated IPs
# or CIDR ranges (e.g. 172.16.0.0/12 for a proxy on a Docker network). Login
# attempts are then counted per real client instead of per proxy. Optional.
#FLOW_TRUSTED_PROXIES=

# Set to 0/false/no/off to disable the recurring-transaction substream
# detection algorithm. Optional, defaults to enabled.
#FLOW_RECURRING_SUBSTREAMS=1

# AI features (card categorization, insights and the Assistant) with Claude are
# set up under AI in Flow's top bar: the Anthropic API key (kept encrypted in
# Flow's database), the model for each feature, the on/off switch and extra
# words to strip from merchant names. Without a key nothing is ever sent.
# README.md (Privacy of AI features) lists exactly what is sent.
#
# The variables below still work (./setup.sh writes ANTHROPIC_API_KEY for a
# first start): a value set here is copied into Flow at every start and wins
# while it stays here, so the AI dialog shows it as set by .env and won't change
# it. Remove the line to manage the value in the app.
#ANTHROPIC_API_KEY=
#FLOW_AI_MODEL=claude-sonnet-5-5
#FLOW_AI_MODEL_CATEGORIZE=
#FLOW_AI_MODEL_ASK=
#FLOW_AI_ENABLED=1
#FLOW_AI_REDACT=
